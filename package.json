{
  "name": "vue3-compare-image",
  "type": "module",
  "version": "1.2.6",
  "private": false,
  "packageManager": "pnpm@10.30.3",
  "description": "A Vue 3 component to compare and slide between two images, supports vertical and horizontal modes, and Keyboard for accessibility.",
  "author": {
    "name": "Cedrouseroll Omondi",
    "email": "omondicedo@gmail.com",
    "url": "https://zedjarvis.github.io"
  },
  "license": "MIT",
  "readme": "./README.md",
  "homepage": "https://vue3-compare-image.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zedjarvis/vue3-compare-image"
  },
  "bugs": "https://github.com/zedjarvis/vue3-compare-image/issues",
  "keywords": [
    "vue-3-compare-image",
    "vue 3 slider",
    "vue3 compare image",
    "picture comparison",
    "image comparison",
    "compare image",
    "image slider",
    "image diff",
    "latest",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "*",
        "dist/*",
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "files": [
    "LICENSE",
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "unbuild",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "dev": "vite serve dev",
    "dev:build": "vite build dev",
    "dev:preview": "vite preview dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm build",
    "release": "pnpm changelogen --release && npm_config_provenance=false pnpm publish && git push --follow-tags",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.0",
    "@types/node": "^25.3.5",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "bumpp": "^10.4.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.0.3",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.3.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "unbuild": "3.6.1",
    "vite": "^7.3.1",
    "vitepress": "1.6.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.29",
    "vue-sfc-transformer": "^0.1.17",
    "vue-tsc": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
